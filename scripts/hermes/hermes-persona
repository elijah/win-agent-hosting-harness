#!/usr/bin/env bash
#
# Hermes Persona Manager
#
# Manages Hermes agent personas following the botfile standard.
# Handles status, plan, and sync operations for persona definitions,
# instructions, and commands across your Hermes agent fleet.
#
# Usage:
#   ./scripts/hermes/hermes-persona status
#   ./scripts/hermes/hermes-persona plan
#   ./scripts/hermes/hermes-persona sync
#   ./scripts/hermes/hermes-persona list
#   ./scripts/hermes/hermes-persona show <persona>
#
set -euo pipefail

# --- Config ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$(cd "$SCRIPT_DIR/../../config/botfile" && pwd)"
CONFIG_FILE="$CONFIG_DIR/config.toml"
TARGET_DIR="$HOME/.hermes"   # Where Hermes stores its personas

# --- Colors ---
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

info()   { printf "${BLUE}[INFO]${NC}  %s\n" "$*"; }
ok()     { printf "${GREEN}[OK]${NC}    %s\n" "$*"; }
warn()   { printf "${YELLOW}[WARN]${NC} %s\n" "$*" >&2; }
err()    { printf "${RED}[ERR]${NC}   %s\n" "$*" >&2; }

# --- Helpers ---

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

# Check if we're running inside WSL
in_wsl() {
  uname -a | grep -qi microsoft
}

# Parse simple TOML selections: [[selections]] blocks
# Returns agent names and their selected sources/plugins/components
parse_selections() {
  local current_section=""
  local current_source=""
  local current_plugin=""
  local current_component=""
  local agents=()

  while IFS= read -r line; do
    # Strip comments
    line="${line%%#*}"
    line="${line%%$'\r'}"

    # Section header
    if [[ "$line" =~ ^\[\[(selections|sources)\]\] ]]; then
      current_section="${BASH_REMATCH[1]}"
      current_source=""
      current_plugin=""
      current_component=""
      agents=()
      continue
    fi

    if [[ "$current_section" == "selections" ]]; then
      if [[ "$line" =~ ^[[:space:]]*source[[:space:]]*=[[:space:]]*\"([^\"]+)\" ]]; then
        current_source="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ ^[[:space:]]*plugin[[:space:]]*=[[:space:]]*\"([^\"]+)\" ]]; then
        current_plugin="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ ^[[:space:]]*component[[:space:]]*=[[:space:]]*\"([^\"]+)\" ]]; then
        current_component="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ ^[[:space:]]*agents[[:space:]]*=[[:space:]]*\[(.*)\] ]]; then
        local agent_list="${BASH_REMATCH[1]}"
        # Extract agent names from quoted strings
        while [[ "$agent_list" =~ \"([^\"]+)\" ]]; do
          agents+=("${BASH_REMATCH[1]}")
          agent_list="${agent_list#*\"${BASH_REMATCH[1]}\"}"
        done
        # Output this selection
        for agent in "${agents[@]}"; do
          echo "${current_source}|${current_plugin}|${current_component}|${agent}"
        done
      fi
    fi
  done < "$CONFIG_FILE"
}

# List all available persona sources
list_sources() {
  info "Botfile sources:"
  if [[ ! -f "$CONFIG_FILE" ]]; then
    err "Config not found: $CONFIG_FILE"
    return 1
  fi

  local in_sources=0
  while IFS= read -r line; do
    line="${line%%#*}"
    line="${line%%$'\r'}"
    if [[ "$line" =~ ^\[\[sources\]\] ]]; then
      in_sources=1
      continue
    fi
    if [[ "$line" =~ ^\[\[ ]]; then
      in_sources=0
      continue
    fi
    if [[ $in_sources -eq 1 ]] && [[ "$line" =~ ^[[:space:]]*name[[:space:]]*=[[:space:]]*\"([^\"]+)\" ]]; then
      echo "  - ${BASH_REMATCH[1]}"
    fi
  done < "$CONFIG_FILE"
}

# Show status of all personas
status() {
  info "Hermes Persona Status"
  echo "===================="
  echo ""

  if [[ ! -f "$CONFIG_FILE" ]]; then
    err "Config not found: $CONFIG_FILE"
    return 1
  fi

  local managed=0
  local missing=0
  local managed_list=()
  local missing_list=()

  echo "Managed personas:"
  while IFS='|' read -r source plugin component agent; do
    [[ -z "$agent" ]] && continue

    local source_path="$CONFIG_DIR/$source"
    local target_dir="$TARGET_DIR/$agent"

    # Check if the component exists in source
    local source_exists="false"
    if [[ -d "$source_path/$plugin" ]]; then
      if [[ -n "$component" ]]; then
        if [[ -e "$source_path/$plugin/$component" ]]; then
          source_exists="true"
        fi
      else
        # Whole plugin selected - check if any components exist
        if [[ -n "$(ls -A "$source_path/$plugin" 2>/dev/null)" ]]; then
          source_exists="true"
        fi
      fi
    fi

    # Check if symlink exists at target
    local target_exists="false"
    if [[ -L "$target_dir/$component" ]] || [[ -d "$target_dir/$component" ]]; then
      target_exists="true"
    fi

    if [[ "$source_exists" == "true" ]] && [[ "$target_exists" == "true" ]]; then
      managed_list+=("✓ $source/$plugin/$component -> $agent")
      managed=$((managed + 1))
    elif [[ "$source_exists" == "true" ]]; then
      missing_list+=("✗ MISSING at target: $source/$plugin/$component -> $agent")
      missing=$((missing + 1))
    else
      missing_list+=("✗ MISSING at source: $source/$plugin/$component")
      missing=$((missing + 1))
    fi
  done < <(parse_selections)

  for entry in "${managed_list[@]}"; do
    [[ -n "$entry" ]] && ok "$entry"
  done

  if [[ ${#missing_list[@]} -gt 0 ]]; then
    warn "Missing or incomplete:"
    for entry in "${missing_list[@]}"; do
      [[ -n "$entry" ]] && warn "$entry"
    done
  fi

  echo ""
  ok "$managed managed, $missing missing"
}

# Plan what would happen on sync
plan() {
  info "Hermes Persona Sync Plan"
  echo "========================="
  echo ""

  if [[ ! -f "$CONFIG_FILE" ]]; then
    err "Config not found: $CONFIG_FILE"
    return 1
  fi

  local create_count=0
  local skip_count=0

  while IFS='|' read -r source plugin component agent; do
    [[ -z "$agent" ]] && continue

    local source_path="$CONFIG_DIR/$source/$plugin"
    local target_dir="$TARGET_DIR/$agent"

    if [[ -n "$component" ]]; then
      local source_component="$source_path/$component"
      local target_component="$target_dir/$component"

      if [[ -e "$source_component" ]]; then
        if [[ -L "$target_component" ]] || [[ -e "$target_component" ]]; then
          skip_count=$((skip_count + 1))
          printf "  skip   %s -> %s/%s (already exists)\n" "$source_component" "$agent" "$component"
        else
          create_count=$((create_count + 1))
          printf "  create %s -> %s/%s\n" "$source_component" "$agent" "$component"
        fi
      else
        warn "  skip   %s -> %s/%s (source not found)" "$source_component" "$agent" "$component"
        skip_count=$((skip_count + 1))
      fi
    fi
  done < <(parse_selections)

  echo ""
  ok "Would create $create_count, skip $skip_count"
}

# Sync personas: create symlinks from sources to targets
sync() {
  info "Syncing Hermes personas..."
  echo ""

  if [[ ! -f "$CONFIG_FILE" ]]; then
    err "Config not found: $CONFIG_FILE"
    return 1
  fi

  local create_count=0
  local skip_count=0

  while IFS='|' read -r source plugin component agent; do
    [[ -z "$agent" ]] && continue

    local source_path="$CONFIG_DIR/$source"
    local source_component="$source_path/$plugin/$component"
    local target_dir="$TARGET_DIR/$agent"
    local target_component="$target_dir/$component"

    if [[ ! -e "$source_component" ]]; then
      warn "skip   Source not found: $source_component"
      skip_count=$((skip_count + 1))
      continue
    fi

    mkdir -p "$target_dir"

    if [[ -n "$component" ]]; then
      local target_component_dir
      target_component_dir="$(dirname "$target_component")"
      mkdir -p "$target_component_dir"
    fi

    if [[ -L "$target_component" ]] || [[ -e "$target_component" ]]; then
      # Check if it's already pointing to the right place
      local existing_target=""
      if [[ -L "$target_component" ]]; then
        existing_target="$(readlink "$target_component")"
      fi
      if [[ "$existing_target" == "$source_component" ]]; then
        skip_count=$((skip_count + 1))
        printf "  skip   %s -> %s (already linked)\n" "$source_component" "$agent"
        continue
      else
        warn "  skipping %s (exists at %s, not a matching link)" "$source_component" "$target_component"
        skip_count=$((skip_count + 1))
        continue
      fi
    fi

    # Make sure the target is within ~/.hermes (for safety)
    local target_abs
    target_abs="$(cd "$target_dir" 2>/dev/null && pwd)"
    if [[ -n "$target_abs" ]] && [[ "$(dirname "$target_abs")" == "$HOME/.hermes" ]]; then
      ln -sf "$source_component" "$target_component"
      ok "  create $source_component -> $target_component"
      create_count=$((create_count + 1))
    else
      warn "  skip   Target not in ~/.hermes: $target_dir"
      skip_count=$((skip_count + 1))
    fi
  done < <(parse_selections)

  echo ""
  ok "Synced: $create_count created, $skip_count skipped"
}

# List all personas
list_personas() {
  info "Available Personas"
  echo "==================="
  echo ""

  if [[ ! -d "$CONFIG_DIR/personal" ]] && [[ ! -d "$CONFIG_DIR/team" ]]; then
    warn "No persona sources found."
    return 0
  fi

  for source_dir in "$CONFIG_DIR"/{personal,team}; do
    if [[ ! -d "$source_dir" ]]; then
      continue
    fi
    local source_name
    source_name="$(basename "$source_dir")"
    echo "Source: $source_name"
    echo "--------"

    for plugin_dir in "$source_dir"/*/; do
      [[ -d "$plugin_dir" ]] || continue
      local plugin_name
      plugin_name="$(basename "$plugin_dir")"
      echo "  Plugin: $plugin_name"

      # List components
      for component in "$plugin_dir"/*; do
        [[ -e "$component" ]] || continue
        local comp_name
        comp_name="$(basename "$component")"
        echo "    - $comp_name"
      done
      echo ""
    done
  done
}

# Show details of a specific persona
show_persona() {
  local persona_name="$1"

  if [[ -z "$persona_name" ]]; then
    err "Usage: hermes-persona show <persona>"
    return 1
  fi

  # Search sources for the persona
  local found="false"
  for source_dir in "$CONFIG_DIR"/{personal,team}; do
    [[ -d "$source_dir" ]] || continue
    for plugin_dir in "$source_dir"/*/; do
      [[ -d "$plugin_dir" ]] || continue
      if [[ -e "$plugin_dir/$persona_name" ]]; then
        found="true"
        info "Persona: $persona_name"
        echo "  Source: $source_dir"
        echo "  Plugin: $(basename "$plugin_dir")"
        echo "  Path: $plugin_dir/$persona_name"

        # If it's a directory, list contents
        if [[ -d "$plugin_dir/$persona_name" ]]; then
          echo "  Contents:"
          ls -la "$plugin_dir/$persona_name"
        fi
        echo ""
      fi
    done
  done

  if [[ "$found" == "false" ]]; then
    err "Persona not found: $persona_name"
    return 1
  fi
}

# Main
main() {
  local command="${1:-}"

  case "$command" in
    status)
      status
      ;;
    plan)
      plan
      ;;
    sync)
      sync
      ;;
    list)
      list_personas
      ;;
    show)
      show_persona "${2:-}"
      ;;
    *)
      echo "Usage: hermes-persona {status|plan|sync|list|show <name>}"
      echo ""
      echo "Commands:"
      echo "  status    Show current persona management status"
      echo "  plan      Show what sync would do without making changes"
      echo "  sync      Create symlinks for personas across Hermes agents"
      echo "  list      List all available personas in all sources"
      echo "  show      Show details of a specific persona"
      echo ""
      echo "Config: $CONFIG_FILE"
      exit 1
      ;;
  esac
}

main "$@"